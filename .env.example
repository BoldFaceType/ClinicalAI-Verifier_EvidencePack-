# ClinicalAI-Verifier environment configuration
#
# Copy this file to .env and fill in values as needed.
# Both variables are OPTIONAL â€” the tools run with sane defaults if unset.

# --- evidence-packer: AI-assisted evidence extraction (--use-ai flag) ---
# Required only when running `evidence-packer --use-ai`.
# Without this, evidence-packer runs in heuristic (keyword-based) mode.
OPENAI_API_KEY=

# --- preflight-validator: DSF-E rule overrides ---
# Optional path to a config.toml that overrides LOINC sets, score
# thresholds, follow-up codes, and the follow-up window (see config.toml).
# Default search: ./config.toml in the current working directory.
CLINICAL_AI_CONFIG=